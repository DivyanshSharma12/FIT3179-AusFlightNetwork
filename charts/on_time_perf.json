{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "On-time performance (brush line to filter ranking)"},
  "data": {"url": "data/otp_time_series_web.csv"},
  "transform": [
    {"calculate": "(toNumber(datum.Departures_On_Time)/toNumber(datum.Sectors_Flown))*100", "as": "on_time_pct"},
    {"calculate": "toDate(datum.Year+'-'+(datum.Month_Num<10?'0'+datum.Month_Num:datum.Month_Num)+'-01')", "as": "date"},
    {"filter": {"field": "Departing_Port", "oneOf": ["Sydney","Melbourne","Brisbane","Perth","Adelaide","Hobart","Darwin"]}},
    {"filter": "datum.Departing_Port !== 'All Ports'"}
  ],
  "vconcat": [
    {
      "width": 940,
      "height": 260,
      "params": [{"name": "brush", "select": {"type": "interval", "encodings": ["x"]}}],
      "mark": {"type": "line", "point": true},
      "encoding": {
        "x": {"field": "date", "type": "temporal", "timeUnit": "yearmonth", "axis": {"title": ""}},
        "y": {"aggregate": "mean", "field": "on_time_pct", "type": "quantitative", "title": "On-time %"},
        "tooltip": [
          {"field": "date", "type": "temporal", "timeUnit": "yearmonth", "title": "Month"},
          {"aggregate": "mean", "field": "on_time_pct", "type": "quantitative", "format": ".1f", "title": "Mean on-time %"}
        ]
      }
    },


    {
      "width": 940,
      "data": {"values": [{"txt": "Australia’s national on-time flight performance remained consistently high through the 2000s, averaging between 82–88%. A sharp decline occurred around 2021, reflecting major operational disruptions 
        during the COVID-19 pandemic. Since then, punctuality has gradually recovered, with current levels stabilising around 75–82% as air travel normalises across the country."}]},
      "mark": {"type": "text", "align": "left", "baseline": "top"},
      "encoding": { "text": {"field": "txt"}, "x": {"value": 0}, "y": {"value": 0} },
      "config": { "text": { "fontSize": 12 } }
    },

    {
      "width": 940,
      "height": {"step": 26},
      "transform": [
        {"filter": {"param": "brush"}},
        {"aggregate": [{"op": "mean", "field": "on_time_pct", "as": "avg_otp"}], "groupby": ["Departing_Port"]}
      ],
      "layer": [
        {
          "mark": "bar",
          "encoding": {
            "y": {"field": "Departing_Port", "type": "ordinal", "sort": "-x", "title": "Airport"},
            "x": {"field": "avg_otp", "type": "quantitative", "title": "Avg on-time %"},
            "tooltip": [
              {"field": "Departing_Port", "title": "Airport"},
              {"field": "avg_otp", "type": "quantitative", "format": ".1f", "title": "Avg on-time %"}
            ]
          }
        },
        {
          "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 4},
          "encoding": {
            "y": {"field": "Departing_Port", "type": "ordinal", "sort": "-x"},
            "x": {"field": "avg_otp", "type": "quantitative"},
            "text": {"field": "avg_otp", "type": "quantitative", "format": ".1f"}
          }
        }
      ]
    },

    {
      "width": 940,
      "data": {"values": [{"txt": "Adelaide stands out as Australia’s most punctual major airport, averaging around 84% of flights departing on time. Perth and Brisbane follow closely behind, both maintaining reliability above 82%. 
        Sydney and Melbourne record similar performance near 80%, while Hobart and Darwin show slightly lower punctuality, reflecting greater weather and operational variability."}]},
      "mark": {"type": "text", "align": "left", "baseline": "top"},
      "encoding": { "text": {"field": "txt"}, "x": {"value": 0}, "y": {"value": 0} },
      "config": { "text": { "fontSize": 12 } }
    }
  ],
  "spacing": 12,
  "padding": 5,
  "config": {"view": {"stroke": null}, "axis": {"labelFontSize": 11, "titleFontSize": 12}}
}
