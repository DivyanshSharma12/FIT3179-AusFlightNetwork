{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 380,
  "title": "Origin–Destination passenger volume (by year)",
  "data": { "url": "data/routes_monthly.csv", "format": {"type": "csv"} },

  "params": [
    { "name": "yearSel", "value": 2019,
      "bind": { "input": "range", "min": 1984, "max": 2020, "step": 1, "name": "Year: " } }
  ],

  "transform": [
    { "calculate": "trim(datum.origin)", "as": "Origin" },
    { "calculate": "trim(datum.destination)", "as": "Destination" },
    { "calculate": "toNumber(datum.year)", "as": "YearNum" },
    { "filter": "isFinite(datum.YearNum) && datum.YearNum == yearSel" },
    { "filter": "datum.Origin !== datum.Destination" },
    { "aggregate": [{"op": "sum", "field": "passengers", "as": "Passengers"}],
      "groupby": ["Origin","Destination"] }
  ],

  "mark": "rect",

  "encoding": {
    "x": {
      "field": "Origin", "type": "nominal", "title": "Origin",
      "sort": ["MELBOURNE","SYDNEY","BRISBANE","ADELAIDE","HOBART","PERTH","DARWIN"],
      "axis": {"labelAngle": -40, "labelLimit": 140}
    },
    "y": {
      "field": "Destination", "type": "nominal", "title": "Destination",
      "sort": ["MELBOURNE","SYDNEY","BRISBANE","ADELAIDE","HOBART","PERTH","DARWIN"]
    },
    "color": {
      "field": "Passengers", "type": "quantitative", "title": "Passengers",
      "scale": { "range": ["#fff5eb", "#fd8d3c", "#b30000"] },
      "legend": { "format": "," }
    },
    "tooltip": [
      {"field": "Origin", "type": "nominal", "title": "From"},
      {"field": "Destination", "type": "nominal", "title": "To"},
      {"field": "Passengers", "type": "quantitative", "format": ","}
    ]
  }
}
